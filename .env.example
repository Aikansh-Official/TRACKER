# MongoDB Compass will show this database after the server writes the first record.
MONGODB_URI=mongodb://127.0.0.1:27017/routine_tracker
JWT_SECRET=replace-this-with-a-long-random-secret
CLIENT_ORIGIN=https://your-tracker-web-app.example
PORT=5000

# Optional server-only AI. Leave disabled until you choose a model and supply your own key.
AI_ENABLED=false
AI_MODEL=
OPENAI_API_KEY=
